{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "The Core — thème de menu scolaire, version 2",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "format": {
      "const": "thecore.school-menu-theme"
    },
    "version": {
      "const": 2
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80,
      "pattern": "^[a-z0-9][a-z0-9_-]*$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80,
      "pattern": "^[^<>\\u0000-\\u001f]+$"
    },
    "theme": {
      "type": "string",
      "enum": [
        "Automne",
        "Hiver",
        "Printemps",
        "Été",
        "Événements"
      ]
    },
    "elements": {
      "type": "array",
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80,
            "pattern": "^[a-z0-9][a-z0-9_-]*$"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 60,
            "pattern": "^[^<>\\u0000-\\u001f]+$"
          },
          "source": {
            "type": "string",
            "maxLength": 2800000,
            "pattern": "^(assets/[a-z0-9][a-z0-9._-]*\\.(png|jpg|jpeg|webp)|data:image/(png|jpeg|webp);base64,[A-Za-z0-9+/]+={0,2})$"
          },
          "anchor": {
            "type": "string",
            "enum": [
              "index",
              "below-badges",
              "ribbon",
              "top-right",
              "bottom",
              "drape-right",
              "drape-corner"
            ]
          },
          "scale": {
            "type": "number",
            "minimum": 40,
            "maximum": 200
          },
          "x": {
            "type": "number",
            "minimum": -60,
            "maximum": 60
          },
          "y": {
            "type": "number",
            "minimum": -60,
            "maximum": 60
          },
          "layer": {
            "type": "string",
            "enum": [
              "front",
              "back"
            ]
          },
          "visible": {
            "type": "boolean"
          },
          "paired": {
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "name",
          "source",
          "anchor",
          "scale",
          "x",
          "y",
          "layer",
          "visible",
          "paired"
        ]
      }
    },
    "style": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "ribbonColor": {
          "type": "string",
          "pattern": "^#[a-fA-F0-9]{6}$",
          "title": "Fond du bandeau",
          "default": "#267a15"
        },
        "ribbonText": {
          "type": "string",
          "pattern": "^#[a-fA-F0-9]{6}$",
          "title": "Texte du bandeau",
          "default": "#ffffff"
        },
        "ribbonShape": {
          "type": "string",
          "enum": [
            "painted",
            "rounded",
            "square"
          ],
          "title": "Forme du bandeau",
          "default": "painted"
        },
        "ribbonRadius": {
          "type": "integer",
          "minimum": 0,
          "maximum": 28,
          "title": "Arrondi du bandeau",
          "default": 10
        },
        "ribbonPadding": {
          "type": "integer",
          "minimum": 8,
          "maximum": 28,
          "title": "Espacement vertical du bandeau",
          "default": 16
        },
        "font": {
          "type": "string",
          "enum": [
            "hand",
            "sans"
          ],
          "title": "Écriture des plats",
          "default": "hand"
        },
        "headingFont": {
          "type": "string",
          "enum": [
            "brush",
            "sans"
          ],
          "title": "Écriture des titres",
          "default": "brush"
        },
        "fontSize": {
          "type": "integer",
          "minimum": 17,
          "maximum": 24,
          "title": "Taille du texte des plats",
          "default": 22
        },
        "ink": {
          "type": "string",
          "pattern": "^#[a-fA-F0-9]{6}$",
          "title": "Couleur du texte des plats",
          "default": "#152e65"
        },
        "lineHeight": {
          "type": "number",
          "minimum": 1,
          "maximum": 1.6,
          "title": "Interligne des plats",
          "default": 1.2
        },
        "dishSpacing": {
          "type": "integer",
          "minimum": 2,
          "maximum": 14,
          "title": "Séparation entre les plats",
          "default": 6
        },
        "pageBackground": {
          "type": "string",
          "pattern": "^#[a-fA-F0-9]{6}$",
          "title": "Fond de la feuille",
          "default": "#ffffff"
        },
        "pagePadding": {
          "type": "integer",
          "minimum": 20,
          "maximum": 48,
          "title": "Marge intérieure à l’écran",
          "default": 36
        },
        "indexWidth": {
          "type": "integer",
          "minimum": 20,
          "maximum": 28,
          "title": "Largeur de la colonne des catégories",
          "default": 24
        },
        "texture": {
          "type": "boolean",
          "title": "Texture papier",
          "default": true
        },
        "days": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "shape": {
              "type": "string",
              "enum": [
                "painted",
                "rounded",
                "square"
              ],
              "title": "Forme des en-têtes",
              "default": "painted"
            },
            "radius": {
              "type": "integer",
              "minimum": 0,
              "maximum": 28,
              "title": "Arrondi des en-têtes",
              "default": 8
            },
            "height": {
              "type": "integer",
              "minimum": 90,
              "maximum": 135,
              "title": "Hauteur des en-têtes sur ordinateur",
              "default": 107
            },
            "padding": {
              "type": "integer",
              "minimum": 10,
              "maximum": 24,
              "title": "Espacement vertical",
              "default": 16
            },
            "fontSize": {
              "type": "integer",
              "minimum": 22,
              "maximum": 32,
              "title": "Taille du nom du jour",
              "default": 26
            },
            "dateSize": {
              "type": "integer",
              "minimum": 14,
              "maximum": 20,
              "title": "Taille de la date",
              "default": 17
            },
            "dateGap": {
              "type": "integer",
              "minimum": 0,
              "maximum": 8,
              "title": "Espace entre le jour et la date",
              "default": 2
            },
            "monday": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "background": {
                  "type": "string",
                  "pattern": "^#[a-fA-F0-9]{6}$",
                  "title": "Fond de l’en-tête",
                  "default": "#ce0047"
                },
                "secondary": {
                  "type": "string",
                  "pattern": "^#[a-fA-F0-9]{6}$",
                  "title": "Seconde couleur du dégradé",
                  "default": "#ff3b7b"
                },
                "gradient": {
                  "type": "boolean",
                  "title": "Dégradé de l’en-tête",
                  "default": true
                },
                "text": {
                  "type": "string",
                  "pattern": "^#[a-fA-F0-9]{6}$",
                  "title": "Texte de l’en-tête",
                  "default": "#ffffff"
                },
                "cellBackground": {
                  "type": "string",
                  "pattern": "^#[a-fA-F0-9]{6}$",
                  "title": "Fond des cellules",
                  "default": "#fff0f5"
                },
                "border": {
                  "type": "string",
                  "pattern": "^#[a-fA-F0-9]{6}$",
                  "title": "Bordure des cellules",
                  "default": "#ff6295"
                }
              },
              "required": [
                "background",
                "secondary",
                "gradient",
                "text",
                "cellBackground",
                "border"
              ]
            },
            "tuesday": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "background": {
                  "type": "string",
                  "pattern": "^#[a-fA-F0-9]{6}$",
                  "title": "Fond de l’en-tête",
