                  "default": "#1bd6e4"
                },
                "secondary": {
                  "type": "string",
                  "pattern": "^#[a-fA-F0-9]{6}$",
                  "title": "Seconde couleur du dégradé",
                  "default": "#70edf1"
                },
                "gradient": {
                  "type": "boolean",
                  "title": "Dégradé de l’en-tête",
                  "default": true
                },
                "text": {
                  "type": "string",
                  "pattern": "^#[a-fA-F0-9]{6}$",
                  "title": "Texte de l’en-tête",
                  "default": "#073b50"
                },
                "cellBackground": {
                  "type": "string",
                  "pattern": "^#[a-fA-F0-9]{6}$",
