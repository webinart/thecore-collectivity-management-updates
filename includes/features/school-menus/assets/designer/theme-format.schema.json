                "gradient",
                "text",
                "cellBackground",
                "border"
              ]
            },
            "thursday": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "background": {
                  "type": "string",
                  "pattern": "^#[a-fA-F0-9]{6}$",
