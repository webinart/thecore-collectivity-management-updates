          },
          "required": [
            "shape",
            "radius",
            "height",
            "padding",
            "fontSize",
            "dateSize",
            "dateGap",
            "monday",
            "tuesday",
            "wednesday",
            "thursday",
            "friday"
          ]
        },
        "courses": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "shape": {
              "type": "string",
              "enum": [
                "painted",
                "rounded",
                "square"
              ],
              "title": "Forme des catégories",
              "default": "painted"
            },
            "radius": {
              "type": "integer",
              "minimum": 0,
              "maximum": 28,
              "title": "Arrondi des catégories",
              "default": 8
            },
            "fontSize": {
              "type": "integer",
              "minimum": 24,
              "maximum": 36,
              "title": "Taille des libellés",
              "default": 30
            },
            "iconSize": {
              "type": "integer",
              "minimum": 28,
              "maximum": 48,
              "title": "Taille des pictogrammes",
              "default": 42
            },
            "padding": {
              "type": "integer",
              "minimum": 8,
              "maximum": 24,
              "title": "Espacement vertical",
              "default": 13
            },
            "starter": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "background": {
                  "type": "string",
                  "pattern": "^#[a-fA-F0-9]{6}$",
                  "title": "Fond de la catégorie",
                  "default": "#267a15"
                },
                "text": {
                  "type": "string",
                  "pattern": "^#[a-fA-F0-9]{6}$",
                  "title": "Texte et pictogramme",
                  "default": "#ffffff"
                },
                "icon": {
                  "type": "string",
                  "enum": [
                    "original",
                    "salad",
                    "utensils",
                    "cake"
                  ],
                  "title": "Pictogramme",
                  "default": "original"
                },
                "secondary": {
                  "type": "string",
                  "pattern": "^#[a-fA-F0-9]{6}$",
                  "title": "Seconde couleur du dégradé",
                  "default": "#408d1d"
                },
                "gradient": {
                  "type": "boolean",
                  "title": "Dégradé de la catégorie",
                  "default": true
                }
              },
              "required": [
