                },
                "gradient": {
                  "type": "boolean",
                  "title": "Dégradé de l’en-tête",
                  "default": true
                },
                "text": {
                  "type": "string",
                  "pattern": "^#[a-fA-F0-9]{6}$",
                  "title": "Texte de l’en-tête",
                  "default": "#492500"
                },
                "cellBackground": {
                  "type": "string",
                  "pattern": "^#[a-fA-F0-9]{6}$",
                  "title": "Fond des cellules",
                  "default": "#fff5e5"
                },
                "border": {
                  "type": "string",
                  "pattern": "^#[a-fA-F0-9]{6}$",
                  "title": "Bordure des cellules",
                  "default": "#ffac30"
                }
              },
              "required": [
                "background",
