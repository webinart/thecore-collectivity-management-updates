                  "default": "#8bd71b"
                },
                "secondary": {
                  "type": "string",
                  "pattern": "^#[a-fA-F0-9]{6}$",
                  "title": "Seconde couleur du dégradé",
                  "default": "#b8ec3c"
                },
                "gradient": {
                  "type": "boolean",
                  "title": "Dégradé de l’en-tête",
                  "default": true
                },
                "text": {
                  "type": "string",
