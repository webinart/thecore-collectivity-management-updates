                },
                "cellBackground": {
                  "type": "string",
                  "pattern": "^#[a-fA-F0-9]{6}$",
                  "title": "Fond des cellules",
                  "default": "#fffce5"
                },
                "border": {
                  "type": "string",
                  "pattern": "^#[a-fA-F0-9]{6}$",
